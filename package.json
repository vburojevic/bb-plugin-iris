{
  "name": "bb-plugin-iris",
  "version": "1.8.0",
  "type": "module",
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Iris",
    "description": "Agents show live, interactive UI in chat: charts, tables, plans, diffs, test runs, pickers and small apps, in your theme's colors.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo-light.svg",
        "dark": "./assets/logo-dark.svg"
      },
      "experimental_icons": {
        "mark": "./assets/icon.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "lucide": "^1.67.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@get-bb/plugin-sdk": "0.6.104",
    "@pierre/diffs": "1.6.2",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "d3-force": "^3.0.1",
    "d3-geo": "^3.1.2",
    "dompurify": "^3.4.17",
    "hono": "^4.11.9",
    "iso-3166-1": "^2.1.1",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "pdfjs-dist": "^6.5.438",
    "sonner": "^1.7.4",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
    "typescript": "^5.7.0",
    "us-atlas": "^3.0.1",
    "vaul": "^1.1.2",
    "vitest": "^3.2.7",
    "world-atlas": "^2.0.2"
  },
  "description": "Live, interactive UI in bb chat: charts, tables, plans, diffs, test runs, pickers and small apps, drawn in your theme.",
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "eval:gate": "tsx evals/run.ts --gate",
    "release:check": "vitest run && tsc --noEmit && tsx evals/run.ts --gate"
